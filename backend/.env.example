# Copy this file to .env (or export these as real environment variables) before
# running with the docker/postgres profile. The default "local" H2 profile needs
# NONE of these to run — every value below has a safe local-dev default baked
# into application.yml.

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Database (docker/postgres profile only) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aicitybrain
DB_USER=aicitybrain
DB_PASSWORD=aicitybrain

# --- Security ---
# REQUIRED to change before any real deployment. Generate with e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-key-change-me-before-deploying-anywhere-please-1234567890
JWT_EXPIRATION_MINUTES=120

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Simulation engine ---
SIM_TICK_INTERVAL_MS=4000
SIM_AUTOSTART=true

# --- AI layer (fully optional — the platform works with none of this set) ---
# Set AI_PROVIDER=llm and provide a real key to swap the rule-based insight
# generator for genuine Claude-generated briefings and what-if narratives.
AI_PROVIDER=rule-based
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
